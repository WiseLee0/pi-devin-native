{
  "name": "pi-devin-native",
  "version": "0.1.0",
  "private": true,
  "files": [
    "index.ts", "src", "README.md", "README.zh-CN.md", "LICENSE",
    "CHANGELOG.md", "SECURITY.md", "CONTRIBUTING.md", "RELEASE.md"
  ],
  "engines": { "node": ">=22.19.0" },
  "type": "module",
  "description": "Native Devin CLI OAuth and Connect/Protobuf provider for original Pi",
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run check:package",
    "release:check": "npm run check && node scripts/check-package.mjs --release",
    "prepublishOnly": "npm run release:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
